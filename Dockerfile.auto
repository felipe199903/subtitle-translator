# Serviço de tradução automática (packages/auto) para rodar no servidor de mídia.
#   docker build -f Dockerfile.auto -t subtitle-translator-auto .
FROM node:22-bookworm-slim

# ffprobe/ffmpeg: ler e extrair as legendas embutidas nos vídeos
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/backend/package.json packages/backend/
COPY packages/auto/package.json packages/auto/
COPY packages/frontend/package.json packages/frontend/
# Só as dependências do backend e do serviço (sem Angular)
RUN npm ci --omit=dev --workspace packages/backend --workspace packages/auto --include-workspace-root=false --no-audit --no-fund

COPY packages/backend/src packages/backend/src
COPY packages/auto/src packages/auto/src
COPY packages/auto/tsconfig.json packages/auto/

ENV NODE_ENV=production DATA_DIR=/data PORT=8787
EXPOSE 8787
USER node
WORKDIR /app/packages/auto
CMD ["/app/node_modules/.bin/tsx", "src/main.ts"]
