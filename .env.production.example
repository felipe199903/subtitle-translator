# Copie para .env.production.local (ignorado pelo git), preencha e rode:
#   npm run go-live -- --dry-run            confere as chaves sem alterar nada
#   npm run go-live -- --confirm acct_...   configura Stripe, Resend e Vercel e publica
# SESSION_SECRET e APP_URL já são criados pelo próprio go-live.

# Obrigatória: resend.com → API Keys (permissão "Full access", para cadastrar o domínio).
RESEND_API_KEY=

# Obrigatória: conta Stripe NOVA deste projeto → Developers → API keys → Secret key.
# Comece com sk_test_ para testar a jornada; troque por sk_live_ quando a conta estiver ativada.
STRIPE_SECRET_KEY=

# Opcional: tradução por IA no Pro. aistudio.google.com/apikey, num projeto com faturamento.
GEMINI_API_KEY=

# Opcional: botão "Continuar com Google". Google Cloud → Credenciais → ID do cliente OAuth (Aplicativo da Web),
# com a origem https://subtitle-translator.com.br.
GOOGLE_CLIENT_ID=

# Opcional: remetente dos e-mails de acesso (padrão: Subtitle Translator <nao-responda@subtitle-translator.com.br>).
EMAIL_FROM=
