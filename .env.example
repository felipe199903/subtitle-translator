# Copie para .env (ou use `npx vercel env pull .env.local`). Nunca commite os valores.

# Neon Postgres (criado pela Vercel em Storage → Create Database → Neon).
# Sem ele, o dev local usa um Postgres embutido (PGlite) em packages/backend/.data/.
DATABASE_URL=

# Endereço público do site (links de e-mail e retornos do Stripe). Na Vercel: https://subtitle-translator.com.br
# No dev local deixe vazio (usa http://localhost:4200).
APP_URL=

# Assina o cookie de sessão. Obrigatória em produção: openssl rand -hex 32
SESSION_SECRET=

# Login com Google: ID do cliente OAuth (Aplicativo da Web).
GOOGLE_CLIENT_ID=

# Link de acesso por e-mail via Resend. Sem a chave, no dev o link é impresso no terminal da API.
RESEND_API_KEY=
EMAIL_FROM=Subtitle Translator <nao-responda@subtitle-translator.com.br>

# Stripe: conta NOVA, exclusiva deste projeto. Prepare-a com `npm run stripe:setup`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Só se o stripe:setup pedir.
STRIPE_PORTAL_CONFIGURATION=

# Tradução por IA no plano Pro (Gemini). Use uma chave de projeto com faturamento ativo.
GEMINI_API_KEY=
# Opcional: modelos em ordem de preferência, separados por vírgula.
GEMINI_MODELS=

# Opcional: e-mail de contato para o tradutor reserva MyMemory (cota de ~5k para ~50k caracteres/dia)
MYMEMORY_EMAIL=
